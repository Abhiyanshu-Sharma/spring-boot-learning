<!DOCTYPE html>

<html>
	<head>
		<title>Signup Page</title>
		
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
	
		<style>
			#menu {
				list-style: none;
			}
			
			#menu li {
				display: inline-block;
			}
		</style>
	</head>
	
	<body>
		<h2>Mini APP SWM18</h2>
		
		<hr>
		
		<ul id="menu">
			<li><a href="show_all" class="btn btn-secondary">Show All Users</a></li>
			<li><a href="home" class="btn btn-secondary">Back To Home</a></li>
		</ul>
		
		<hr>
		
		<div class="alert alert-success w-25 m-auto mb-4" th:if="${msg}" th:text="${msg}"></div>
		
		<div class="w-25 p-5 border border-secondary rounded m-auto">
			<form action="signup" th:object="${user_dto}" method="post">				
				<div class="mb-3">
					<label for="name" class="form-label">User Name</label>
					<input type="text" th:field="*{name}" class="form-control" id="name" placeholder="Enter Name">
				</div>
				<div class="mb-3">
					<label for="email" class="form-label">Email</label>
					<input type="email" th:field="*{email}" class="form-control" id="email" placeholder="Enter Email">
				</div>
				<div class="mb-3">
					<label for="phone" class="form-label">Phone</label>
					<input type="tel" th:field="*{phone}" id="phone" class="form-control" placeholder="Enter Phone">
				</div>
				
				<div class="text-center">
					<input type="submit" value="SignUp" class="btn btn-success">
				</div>
			</form>
		</div>
	</body>
</html>